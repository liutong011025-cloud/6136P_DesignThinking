# Copy this file to .env.local for local development.
# In Vercel, set these three values in Project Settings -> Environment Variables.
# Use a separate INT6136P PostgreSQL database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Replace with an independent random secret of at least 32 characters.
SESSION_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# Set Nicole's existing teacher login password in your environment only.
TEACHER_PASSWORD=""
