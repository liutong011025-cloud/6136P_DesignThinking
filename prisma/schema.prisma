generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model CourseMetadata {
  id Int @id @default(1)
  courseId String
  createdAt DateTime @default(now())
}
model Group {
  id Int @id
  name String @unique
  draft Json @default("{}")
  revision Int @default(0)
  empathizeCompletedAt DateTime?
  updatedAt DateTime @updatedAt
  members Member[]
  observations Observation[]
  submissions Submission[]
  feedback Feedback[]
  works WorkSubmission[]
}
model Member {
  id String @id @default(cuid())
  groupId Int
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name String
  nameKey String
  createdAt DateTime @default(now())
  observations Observation[]
  comments Comment[]
  reflection Reflection?
  works WorkSubmission[]
  @@unique([groupId, nameKey])
}
model Observation {
  id String @id @default(cuid())
  groupId Int
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId String
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user String
  context String
  body String
  source String
  sourceDetail String @default("")
  referenceUrl String @default("")
  publicationYear Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments Comment[]
  attachment Attachment?
  @@index([groupId, createdAt])
}
model Comment {
  id String @id @default(cuid())
  observationId String
  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  memberId String
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  body String
  createdAt DateTime @default(now())
}
model Attachment {
  id String @id @default(cuid())
  observationId String @unique
  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  filename String
  mime String
  bytes Bytes
  size Int
}
model Submission {
  id String @id @default(cuid())
  groupId Int
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  version Int
  snapshot Json
  submittedBy String
  createdAt DateTime @default(now())
  @@unique([groupId, version])
}
model Feedback {
  id String @id @default(cuid())
  groupId Int
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  body String
  createdAt DateTime @default(now())
}
model Reflection {
  id String @id @default(cuid())
  memberId String @unique
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  body String
  updatedAt DateTime @updatedAt
}
model LoginLimit {
  key String @id
  count Int @default(0)
  expiresAt DateTime
}
model WorkSubmission {
  id String @id @default(cuid())
  groupId Int
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId String
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  requestId String
  fingerprint String
  title String
  kind String
  description String @default("")
  links Json @default("[]")
  submittedBy String
  version Int?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  files WorkFile[]
  @@unique([memberId, requestId])
  @@unique([groupId, version])
  @@index([groupId, publishedAt])
}
model WorkFile {
  id String @id @default(cuid())
  workId String
  work WorkSubmission @relation(fields: [workId], references: [id], onDelete: Cascade)
  filename String
  mime String
  size Int
  chunkCount Int
  position Int
  chunks WorkChunk[]
  @@unique([workId, position])
}
model WorkChunk {
  fileId String
  file WorkFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  index Int
  bytes Bytes
  size Int
  @@id([fileId, index])
}
